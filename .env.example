# Systronaut Deploy -- environment. Copy to `.env` and fill in.
# NEVER commit the real .env (see .gitignore).

# --- Control plane -----------------------------------------------------------
# Flask session signing key. Generate: openssl rand -hex 32
CONTROL_PLANE_SECRET=

# Web UI accounts (role-based). Operators deploy; admins also destroy + see audit.
ADMIN_USER=admin
ADMIN_PASSWORD=                 # set a strong password, or use ADMIN_PASSWORD_HASH
# ADMIN_PASSWORD_HASH=          # werkzeug pbkdf2 hash (preferred over plaintext)
OPERATOR_USER=operator
OPERATOR_PASSWORD=

# REST API bearer tokens by role. Generate: openssl rand -hex 24
API_ADMIN_TOKEN=
API_OPERATOR_TOKEN=

# Set to 1 behind HTTPS/a reverse proxy to enable Secure cookies + HSTS.
SESSION_COOKIE_SECURE=0

# Update check: a plain-text URL whose first line is the latest version string
# (e.g. the raw VERSION file on your git host). The console shows a banner when a
# newer version is available. Leave empty to disable. APP_VERSION is set
# automatically by update.sh from the local VERSION file.
UPDATE_CHECK_URL=
# APP_VERSION=1.0.0

# --- PXE engine --------------------------------------------------------------
# Shared bearer token between control-plane and pxe-engine API.
PXE_ENGINE_TOKEN=
# LAN-facing interface + subnet for proxyDHCP, and this host's IP.
PXE_INTERFACE=eth0
PXE_SUBNET=192.168.0.0
PXE_HOST_IP=192.168.0.10
PXE_BOOTFILE=snponly.efi

# --- Cloud / hypervisor adapters ---------------------------------------------
# vSphere (REAL adapter). Creates a UEFI/Secure-Boot VM on the PXE port group,
# then it network-boots into the same hardened install path. control-plane reads
# these via env_file, so it also needs PXE_HOST_IP set above.
# VSPHERE_HOST=vcenter.example.com
# VSPHERE_USER=administrator@vsphere.local
# VSPHERE_PASSWORD=
# VSPHERE_DATACENTER=DC1
# VSPHERE_CLUSTER=Cluster1          # optional; else first resource pool is used
# VSPHERE_DATASTORE=datastore1
# VSPHERE_NETWORK=PXE-PortGroup     # the port group the PXE engine serves
# VSPHERE_FOLDER=                   # optional VM folder
# VSPHERE_INSECURE=0                # 1 = skip TLS verify (dev self-signed only)
#
# libvirt / KVM (REAL adapter). Creates a UEFI/Secure-Boot domain on the PXE L2,
# then it network-boots into the same hardened install path. The guest NIC must
# reach the pxe-engine: use a host bridge on the PXE LAN (preferred) or a libvirt
# network. Needs libvirt-python + host libvirt reachable at LIBVIRT_URI.
# LIBVIRT_URI=qemu+ssh://root@kvm-host/system   # or qemu:///system on the host
# LIBVIRT_BRIDGE=br-pxe            # host bridge on the PXE LAN (preferred)
# LIBVIRT_NETWORK=                 # OR a libvirt network name (if no bridge)
# LIBVIRT_POOL=default             # storage pool for the boot disk
# LIBVIRT_DISK_GB=40

# Proxmox VE (REAL adapter). Creates an OVMF/Secure-Boot VM whose net0 is on the
# PXE bridge, then it network-boots into the hardened install. Prefer an API
# token over a password.
# PROXMOX_HOST=pve.example.com
# PROXMOX_USER=root@pam            # or svc-deploy@pve for a token identity
# PROXMOX_TOKEN_NAME=deploy        # API token id (preferred)
# PROXMOX_TOKEN_VALUE=             # API token secret
# PROXMOX_PASSWORD=                # fallback if no token
# PROXMOX_NODE=pve1                # target node name
# PROXMOX_STORAGE=local-lvm        # storage for efidisk + boot disk
# PROXMOX_BRIDGE=vmbr0             # bridge that reaches the pxe-engine
# PROXMOX_DISK_GB=40
# PROXMOX_INSECURE=0               # 1 = skip TLS verify (dev self-signed only)

# ESXi (standalone)
# ESXI_HOST=
# ESXI_USER=
# ESXI_PASSWORD=
# OpenStack (STUB adapter). Nova does NOT PXE-boot, so it can't reuse the shared
# hardened PXE path; it needs a hardened base image + cloud-init that applies the
# CIS/NIS2 controls on first boot (see REQUIREMENTS.md). Credentials below are
# the standard OS_* clouds vars, surfaced now so preflight can validate them.
# OS_AUTH_URL=
# OS_USERNAME=
# OS_PASSWORD=
# OS_PROJECT_NAME=
