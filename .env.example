# Systronaut Deploy -- environment. Copy to `.env` and fill in.
# NEVER commit the real .env (see .gitignore).

# --- Control plane -----------------------------------------------------------
# Flask session signing key. Generate: openssl rand -hex 32
CONTROL_PLANE_SECRET=

# Web UI accounts (role-based). Operators deploy; admins also destroy + see audit.
ADMIN_USER=admin
ADMIN_PASSWORD=                 # set a strong password, or use ADMIN_PASSWORD_HASH
# ADMIN_PASSWORD_HASH=          # werkzeug pbkdf2 hash (preferred over plaintext)
OPERATOR_USER=operator
OPERATOR_PASSWORD=

# REST API bearer tokens by role. Generate: openssl rand -hex 24
API_ADMIN_TOKEN=
API_OPERATOR_TOKEN=

# Set to 1 behind HTTPS/a reverse proxy to enable Secure cookies + HSTS.
SESSION_COOKIE_SECURE=0

# Update check: a plain-text URL whose first line is the latest version string
# (e.g. the raw VERSION file on your git host). The console shows a banner when a
# newer version is available. Leave empty to disable. APP_VERSION is set
# automatically by update.sh from the local VERSION file.
UPDATE_CHECK_URL=
# APP_VERSION=1.0.0

# --- PXE engine --------------------------------------------------------------
# Shared bearer token between control-plane and pxe-engine API.
PXE_ENGINE_TOKEN=
# LAN-facing interface + subnet for proxyDHCP, and this host's IP.
PXE_INTERFACE=eth0
PXE_SUBNET=192.168.0.0
PXE_HOST_IP=192.168.0.10
PXE_BOOTFILE=snponly.efi

# --- Cloud / hypervisor adapters ---------------------------------------------
# vSphere (REAL adapter). Creates a UEFI/Secure-Boot VM on the PXE port group,
# then it network-boots into the same hardened install path. control-plane reads
# these via env_file, so it also needs PXE_HOST_IP set above.
# VSPHERE_HOST=vcenter.example.com
# VSPHERE_USER=administrator@vsphere.local
# VSPHERE_PASSWORD=
# VSPHERE_DATACENTER=DC1
# VSPHERE_CLUSTER=Cluster1          # optional; else first resource pool is used
# VSPHERE_DATASTORE=datastore1
# VSPHERE_NETWORK=PXE-PortGroup     # the port group the PXE engine serves
# VSPHERE_FOLDER=                   # optional VM folder
# VSPHERE_INSECURE=0                # 1 = skip TLS verify (dev self-signed only)
#
# ESXi (standalone)
# ESXI_HOST=
# ESXI_USER=
# ESXI_PASSWORD=
# OpenStack
# OS_AUTH_URL=
# OS_USERNAME=
# OS_PASSWORD=
# OS_PROJECT_NAME=
