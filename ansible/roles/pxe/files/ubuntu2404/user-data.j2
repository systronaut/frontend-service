#cloud-config
# Systronaut Ubuntu autoinstall — rendered per-host (NIS2/ISO 27001).
# Profile: {{ security_profile }}
autoinstall:
  version: 1
  source:
    id: ubuntu-server
  identity:
    hostname: {{ hostname }}
    username: systronaut
    # Locked placeholder — replace via operator secrets before prod.
    password: "!"
  locale: "en_US.UTF-8"
  keyboard:
    layout: us
  timezone: "Etc/UTC"
  ssh:
    install-server: true
    allow-pw: false
  storage:
    layout:
      name: lvm
      sizing-policy: all
{% if harden_disk_encryption and disk_passphrase %}
      password: {{ disk_passphrase | tojson }}
{% endif %}
      match:
        path: /dev/sda
  packages:
    - curl
{% if harden_audit_logging %}
    - auditd
{% endif %}
  late-commands:
    - curtin in-target --target=/target -- curl -sf {{ hardening_url }} -o /tmp/systronaut-hardening.env
    - curtin in-target --target=/target -- curl -sf {{ cis_linux_url }} -o /tmp/systronaut-cis-linux.sh
    - curtin in-target --target=/target -- sh -c "set -a; . /tmp/systronaut-hardening.env; set +a; sh /tmp/systronaut-cis-linux.sh"
