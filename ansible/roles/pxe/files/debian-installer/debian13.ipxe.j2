#!ipxe
# Ansible Vorlage — per-host preseed when have_answer (package_role from WebUI).
set base_url http://{{ host_ip }}/debian13
{% if have_answer %}
set preseed_url {{ answer_url }}/{{ answer_name }}
console --picture ${base_url}/splash.png || echo No splash image found
echo Loading hardened Debian install...
kernel ${base_url}/linux auto=true priority=critical vga=normal url=${preseed_url} ---
initrd ${base_url}/initrd.gz
boot
{% else %}
set preseed_url http://{{ host_ip }}/lookup/debian-installer/appserver.cfg
console --picture ${base_url}/splash.png || echo No splash image found
menu Debian 13.4 Installation Menu
item appserver   Install App Server (lab)
item dbserver    Install DB Server (lab preseed)
choose --default appserver --timeout 10000 selected || goto cancel
goto ${selected}
:appserver
echo Loading App Server Installer...
kernel ${base_url}/linux auto=true priority=critical vga=normal url=${preseed_url} ---
initrd ${base_url}/initrd.gz
boot
:dbserver
echo Loading DB Server Installer...
kernel ${base_url}/linux auto=true priority=critical vga=normal preseed/file=/dbserver.cfg ---
initrd ${base_url}/initrd.gz
boot
:cancel
echo User cancelled, booting from local disk...
exit
{% endif %}
