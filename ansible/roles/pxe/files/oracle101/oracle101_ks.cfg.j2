# Systronaut kickstart — rendered per-host (NIS2/ISO 27001 secure install).
# Ansible Vorlage; prefer control-plane answers/kickstart.j2 when available.
# Profile: {{ security_profile }} ({{ standards | join(', ') or 'baseline' }})
#version=OL10
text
eula --agreed
keyboard --vckeymap={{ keyboard | default('us') }} --xlayouts='{{ keyboard | default('us') }}'
lang {{ locale | default('en_US.UTF-8') }}
timezone {{ timezone | default('Etc/UTC') }} --utc
firstboot --disable
reboot

network --bootproto={% if net_mode == 'static' and ip %}static --ip={{ ip }} --netmask={{ netmask }}{% if gateway %} --gateway={{ gateway }}{% endif %}{% if dns %} --nameserver={{ dns }}{% endif %}{% else %}dhcp{% endif %} --hostname={{ hostname }} --device=link --activate

{% if harden_disk_encryption and disk_passphrase %}
ignoredisk --only-use={{ disk_device | default('sda') }}
clearpart --drives={{ disk_device | default('sda') }} --all --initlabel
autopart --type=lvm --encrypted --passphrase={{ disk_passphrase }}
{% else %}
ignoredisk --only-use={{ disk_device | default('sda') }}
clearpart --drives={{ disk_device | default('sda') }} --all --initlabel
autopart --type=lvm
{% endif %}

{% if admin_password_hash %}
rootpw --iscrypted {{ admin_password_hash }}
user --groups=wheel --name={{ admin_user | default('systronaut') }} --gecos="{{ admin_user | default('systronaut') }}" --password={{ admin_password_hash }} --iscrypted
{% else %}
rootpw --lock
user --groups=wheel --name={{ admin_user | default('systronaut') }} --gecos="Systronaut" --password=* --lock
{% endif %}

%packages
{% if harden_minimal_install %}
@core
{% else %}
@^minimal-environment
{% endif %}
openssh-server
curl
{% if harden_audit_logging %}
audit
{% endif %}
{% if harden_host_firewall %}
firewalld
{% endif %}
{% if harden_time_sync %}
chrony
{% endif %}
%end

%post --erroronfail
#!/bin/sh
set -eu
{% if ssh_pubkey %}
ADMIN_USER="{{ admin_user | default('systronaut') }}"
install -d -m 700 -o "$ADMIN_USER" -g "$ADMIN_USER" "/home/$ADMIN_USER/.ssh"
printf '%s\n' '{{ ssh_pubkey }}' >> "/home/$ADMIN_USER/.ssh/authorized_keys"
chmod 600 "/home/$ADMIN_USER/.ssh/authorized_keys"
chown -R "$ADMIN_USER:$ADMIN_USER" "/home/$ADMIN_USER/.ssh"
{% endif %}
curl -sf "{{ hardening_url }}" -o /tmp/systronaut-hardening.env
curl -sf "{{ cis_linux_url }}" -o /tmp/systronaut-cis-linux.sh
set -a
# shellcheck disable=SC1091
. /tmp/systronaut-hardening.env
set +a
sh /tmp/systronaut-cis-linux.sh
%end
