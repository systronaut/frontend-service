<?xml version="1.0"?>
<!DOCTYPE profile>
<profile xmlns="http://www.suse.com/1.0/yast2ns" xmlns:config="http://www.suse.com/1.0/configns">
  <bootloader>
    <loader_type>grub2-efi</loader_type>
  </bootloader>
  <general>
    <ask-list config:type="list"/>
    <mode>
      <confirm config:type="boolean">false</confirm>
      <second_stage config:type="boolean">false</second_stage>
    </mode>
  </general>

  <add-on t="map">
    <add_on_products t="list">
      <listentry t="map">
	<media_url>relurl:///</media_url>
        <product>sle-module-basesystem</product>
        <product_dir>/Module-Basesystem</product_dir>
      </listentry>
      <listentry t="map">
	<media_url>relurl:///</media_url>
        <product>sle-module-transactional-server</product>
        <product_dir>/Module-Transactional-Server</product_dir>
      </listentry>
      <listentry t="map">
	<media_url>relurl:///</media_url>
        <product>sle-module-server-applications</product>
        <product_dir>/Module-Server-Applications</product_dir>
      </listentry>
      <listentry t="map">
	<media_url>relurl:///</media_url>
        <product>sle-module-python3</product>
        <product_dir>/Module-Python3</product_dir>
      </listentry>
      <listentry t="map">
	<media_url>relurl:///</media_url>
        <product>sle-module-desktop-applications</product>
        <product_dir>/Module-Desktop-Applications</product_dir>
      </listentry>
      <listentry t="map">
	<media_url>relurl:///</media_url>
        <product>sle-module-web-scripting</product>
        <product_dir>/Module-Web-Scripting</product_dir>
      </listentry>
      <listentry t="map">
	<media_url>relurl:///</media_url>
        <product>sle-module-live-patching</product>
        <product_dir>/Module-Live-Patching</product_dir>
      </listentry>
      <listentry t="map">
	<media_url>relurl:///</media_url>
        <product>sle-module-legacy</product>
        <product_dir>/Module-Legacy</product_dir>
      </listentry>
      <listentry t="map">
	<media_url>relurl:///</media_url>
        <product>sle-module-development-tools</product>
        <product_dir>/Module-Development-Tools</product_dir>
      </listentry>
    </add_on_products>
  </add-on>
  
  <services-manager t="map">
    <default_target>graphical</default_target>
    <services t="map">
      <enable t="list">
        <service>YaST2-Firstboot</service>
        <service>YaST2-Second-Stage</service>
        <service>apparmor</service>
        <service>appstream-sync-cache</service>
        <service>auditd</service>
        <service>bluetooth</service>
        <service>klog</service>
        <service>cron</service>
        <service>firewalld</service>
        <service>wickedd-auto4</service>
        <service>wickedd-dhcp4</service>
        <service>wickedd-dhcp6</service>
        <service>wickedd-nanny</service>
        <service>display-manager</service>
        <service>irqbalance</service>
        <service>iscsi</service>
        <service>issue-generator</service>
        <service>kbdsettings</service>
        <service>kdump</service>
        <service>kdump-early</service>
        <service>kdump-notify</service>
        <service>lvm2-monitor</service>
        <service>wicked</service>
        <service>nscd</service>
        <service>nvmefc-boot-connections</service>
        <service>nvmf-autoconnect</service>
        <service>oracle</service>
        <service>postfix</service>
        <service>purge-kernels</service>
        <service>rollback</service>
        <service>rsyslog</service>
        <service>sapconf</service>
        <service>smartd</service>
        <service>sshd</service>
        <service>sysctl-logger</service>
        <service>systemd-pstore</service>
        <service>systemd-remount-fs</service>
        <service>virtqemud</service>
        <service>virtxend</service>
        <service>xencommons</service>
      </enable>
      <on_demand t="list">
        <listentry>iscsid</listentry>
        <listentry>pcscd</listentry>
        <listentry>uuidd</listentry>
        <listentry>virtlockd</listentry>
        <listentry>virtlogd</listentry>
        <listentry>virtnetworkd</listentry>
        <listentry>virtnodedevd</listentry>
        <listentry>virtnwfilterd</listentry>
        <listentry>virtsecretd</listentry>
        <listentry>virtstoraged</listentry>
      </on_demand>
    </services>
  </services-manager>
  
  <keyboard>
    <keymap>english-us</keymap>
  </keyboard>
  <language>
    <language>en_US</language>
    <languages/>
  </language>
  <partitioning config:type="list">
    <drive>
      <device>/dev/sda</device>
      <use>all</use>
    </drive>
  </partitioning>

